# =========================
# ОКРУЖЕНИЕ
# =========================
ENV=


# =========================
# ПРИЛОЖЕНИЕ
# =========================
APP_TITLE='Бронирование мест в кафе'
APP_DESC='Сервис бронирования мест в кафе'


# =========================
# БАЗА ДАННЫХ (PostgreSQL)
# =========================
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=cafe_db
POSTGRES_HOST=db
POSTGRES_PORT=5432


# =========================
# АУТЕНТИФИКАЦИЯ / БЕЗОПАСНОСТЬ
# =========================
SECRET=SUPER_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30


# =========================
# ИНИЦИАЛЬНЫЙ СУПЕРПОЛЬЗОВАТЕЛЬ
# =========================
FIRST_SUPERUSER_EMAIL=superuser@example.com
FIRST_SUPERUSER_PASSWORD=super_password


# =========================
# ЛОГИРОВАНИЕ
# =========================
LOG_LEVEL=INFO
LOG_CONSOLE_ENABLED=false
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/app.log
LOG_FILE_MAX_SIZE=10 MB
LOG_FILE_ROTATION_COUNT=5
# LOG_FILE_COMPRESSION=zip  # Опционально


# =========================
# TASKS
# =========================
CELERY_BROKER_URL="amqp://guest:guest@rabbitmq:5672//"
CELERY_RESULT_BACKEND="rpc://"
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=admin:admin
